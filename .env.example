# Standard Ebooks Bridge - example environment file.
# Copy to .env and edit. NEVER commit a real .env; it holds no secrets today,
# but keeping it out of git means that stays true if that ever changes.

# --- Upstream target -------------------------------------------------------
# Public base URL of the site we read. Do not point this at a private host.
SE_BRIDGE_BASE_URL=https://standardebooks.org

# --- Politeness ------------------------------------------------------------
# Maximum outbound requests per second. The site publishes no crawl-delay, so
# 1.0 is the safe default. Lower it if you run several workers.
SE_BRIDGE_REQUESTS_PER_SECOND=1.0

# How long a successful response is reused before the page is fetched again.
SE_BRIDGE_CACHE_TTL_SECONDS=300

# Identify yourself. Include a contact so a maintainer can reach you.
SE_BRIDGE_USER_AGENT=standard-ebooks-bridge/1.0 (+https://example.invalid/standard-ebooks-bridge)

# --- Timeouts and retries --------------------------------------------------
SE_BRIDGE_CONNECT_TIMEOUT_SECONDS=5.0
SE_BRIDGE_READ_TIMEOUT_SECONDS=15.0
# Total attempts per request, including the first one.
SE_BRIDGE_MAX_ATTEMPTS=3
SE_BRIDGE_BACKOFF_BASE_SECONDS=1.0
SE_BRIDGE_BACKOFF_MAX_SECONDS=30.0

# --- Circuit breaker -------------------------------------------------------
# Consecutive upstream failures that open the breaker...
SE_BRIDGE_CIRCUIT_FAILURE_THRESHOLD=5
# ...and how long it stays open before a single trial request is allowed.
SE_BRIDGE_CIRCUIT_COOLDOWN_SECONDS=60.0

# --- API limits ------------------------------------------------------------
# The upstream paginator accepts any positive integer; we cap it here so one
# caller cannot ask the site for an unbounded page.
SE_BRIDGE_MAX_PAGE_SIZE=48
SE_BRIDGE_DEFAULT_PAGE_SIZE=12
# Longest accepted free-text search query, in characters.
SE_BRIDGE_MAX_QUERY_LENGTH=200

# --- Observability ---------------------------------------------------------
SE_BRIDGE_LOG_LEVEL=INFO
