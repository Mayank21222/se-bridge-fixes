          "name": {
            "description": "Name of the contributor.",
            "title": "Name",
            "type": "string"
          },
          "role": {
            "description": "Credit as printed, e.g. 'Translated'.",
            "title": "Role",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Link the catalogue publishes for them.",
            "title": "Url"
          }
        },
        "required": [
          "role",
          "name"
