            "title": "Name",
            "type": "string"
          },
          "same_as": {
            "description": "Authority links the catalogue publishes, e.g. Library of Congress or Wikipedia.",
            "items": {
              "type": "string"
            },
            "title": "Same As",
            "type": "array"
          },
          "slug": {
            "description": "URL-safe author slug, used as the author filter value.",
            "title": "Slug",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Canonical public page for this author.",
            "title": "Url"
          }
        },
        "required": [
          "name",
          "slug"
