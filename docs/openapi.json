  "info": {
    "description": "\nA read-only JSON bridge over the public [Standard Ebooks](https://standardebooks.org)\ncatalogue, which publishes no API. Responses always use the same envelope:\n\n```json\n{\"data\": ..., \"meta\": {\"page\": 1, \"page_size\": 12, \"total\": null,\n                       \"source_url\": \"https://standardebooks.org/ebooks?...\",\n                       \"fetched_at\": \"2026-01-01T00:00:00Z\", \"cached\": false}}\n```\n\nFailures always use `{\"error\": {\"code\": ..., \"message\": ..., \"retryable\": ...}}`\nwith one of `BAD_REQUEST` (400), `NOT_FOUND` (404), `RATE_LIMITED` (429),\n`UPSTREAM_BLOCKED` (502) and `UPSTREAM_CHANGED` (502).\n",
    "title": "Standard Ebooks Bridge",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report whether this service is up and whether the site answered.\n\nAlways answers 200. A site that cannot be reached sets\n`data.upstream_reachable` to false and `data.status` to `degraded`.\nThe probe goes through the same cache, rate limit and circuit breaker\nas any other call, so polling this endpoint cannot overload anything.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or missing parameters"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such record"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Throttled locally or by the site"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upstream blocked or changed"
          }
        },
        "summary": "Service and upstream health",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/authors/{author_slug}": {
      "get": {
        "description": "Return all catalogue entries for one author.\n\nThe site's author page is a single unpaginated page, so this response\nis always page 1 with a real `meta.total`.",
        "operationId": "list_author_ebooks_v1_authors__author_slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "author_slug",
            "required": true,
            "schema": {
              "title": "Author Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_EbookSummary__"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or missing parameters"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such record"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Throttled locally or by the site"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upstream blocked or changed"
          }
        },
        "summary": "List every ebook by one author",
        "tags": [
          "records"
        ]
      }
    },
    "/v1/ebooks": {
      "get": {
        "description": "Return one page of the public catalogue, newest first by default.",
        "operationId": "list_ebooks_v1_ebooks_get",
        "parameters": [
          {
            "description": "1-based page number. Must be 1 or greater.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based page number. Must be 1 or greater.",
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page, at least 1. The ceiling is SE_BRIDGE_MAX_PAGE_SIZE (48 by default); anything larger is rejected with BAD_REQUEST.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 12,
              "description": "Items per page, at least 1. The ceiling is SE_BRIDGE_MAX_PAGE_SIZE (48 by default); anything larger is rejected with BAD_REQUEST.",
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "description": "Subject slug, e.g. 'science-fiction'. An unknown but well-formed slug returns an empty page.",
            "in": "query",
            "name": "subject",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Subject slug, e.g. 'science-fiction'. An unknown but well-formed slug returns an empty page.",
              "title": "Subject"
            }
          },
          {
            "description": "One of: newest (default), author-alpha, reading-ease, length, popularity. 'relevance' is search-only; see /v1/search.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One of: newest (default), author-alpha, reading-ease, length, popularity. 'relevance' is search-only; see /v1/search.",
              "title": "Sort"
            }
          }
        ],
        "responses": {
