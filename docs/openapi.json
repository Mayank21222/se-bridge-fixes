            "description": "True when served from the local response cache without hitting the site.",
            "title": "Cached",
            "type": "boolean"
          },
          "fetched_at": {
            "description": "When this payload was produced (ISO 8601, UTC).",
            "title": "Fetched At",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
