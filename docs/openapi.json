            "type": "string"
          },
          "url": {
            "description": "Absolute URL of the credited page.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "title": "SourceRef",
        "type": "object"
      },
      "SubjectFacet": {
