          "name": {
            "description": "Display name of the collection.",
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "description": "URL-safe collection slug.",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "title": "CollectionRef",
        "type": "object"
      },
      "ContributorRef": {
